# Dev : base SQLite locale. Prod : TURSO_DATABASE_URL + TURSO_AUTH_TOKEN (prioritaires).
DATABASE_URL="file:./prisma/dev.db"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
MISTRAL_API_KEY=
# Optionnel : modèle du lecteur et des textes (défaut mistral-large-latest)
MISTRAL_READER_MODEL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OWNER_EMAIL=
# Dev uniquement : session du propriétaire sans passer par Google
AUTH_DEV_BYPASS=1

# Notifications push (npx web-push generate-vapid-keys) et secret des tâches planifiées
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
CRON_SECRET=
