// Russian Training — data model.
// Reference data (DictionaryEntry / DictionaryForm) is read-only, seeded from the
// OpenRussian dataset + curated supplement. User data (Encounter / QuizAttempt) is mutable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A dictionary word in its base (lemma) form. Seeded, never mutated by the user.
model DictionaryEntry {
  id             Int     @id @default(autoincrement())
  bare           String // dictionary form without stress marks (lowercased, e folded)
  accented       String // dictionary form with stress marks
  type           String // 'noun' | 'verb' | 'adjective' | 'pronoun' | 'numeral' | 'other'
  gender         String? // nouns/pronouns: 'm' | 'f' | 'n'
  aspect         String? // verbs: 'imperfective' | 'perfective'
  animate        Boolean?
  indeclinable   Boolean?
  sgOnly         Boolean?
  plOnly         Boolean?
  comparative    String?
  superlative    String?
  partner        String? // aspectual partner (verbs) or counterpart
  translationsFr String?
  frManual       Boolean @default(false) // true = user-entered FR translation (preserved across reseed)
  // true = the FR gloss was filled/repaired by the AI against the (reliable) EN gloss, at
  // question time. Prevents re-checking the same entry on every card. See ensureFrenchGloss().
  frChecked      Boolean @default(false)
  // true = DeepL has already been asked for a second FR candidate for this word (merged into
  // translationsFr if new). Prevents re-querying DeepL on every card. See ensureFrenchGloss().
  deeplChecked   Boolean @default(false)
  translationsEn String?
  translationsDe String?
  // true = ce lemme fait partie du Lexique minimum B1 (Андрюшина et al., Златоуст), posé par
  // scripts/import-b1-lexicon.ts depuis data/B1/lexique_b1.json. Alimente /objectif-b1.
  inB1Minimum    Boolean @default(false)

  forms      DictionaryForm[]
  encounters Encounter[]
  attempts   QuizAttempt[]

  @@index([bare])
  @@index([type])
}

/// A single inflected form of an entry. Also serves as the reverse-lookup index for detection.
model DictionaryForm {
  id           Int    @id @default(autoincrement())
  entryId      Int
  formKey      String // e.g. 'sg_gen', 'presfut_sg1', 'decl_f_acc', 'prn_gen', 'num_inst'
  accented     String // form with stress marks
  bareForm     String // normalized: stress stripped, lowercased, e variants folded
  variantIndex Int    @default(0) // for comma-separated alternatives within one cell

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([bareForm])
  @@index([entryId])
}

/// A word the user has encountered in their reading. Each row fills one paradigm cell.
model Encounter {
  id             Int      @id @default(autoincrement())
  entryId        Int?
  rawInput       String // exactly what the user typed
  matchedFormKey String? // which paradigm cell this encounter discovered
  source         String? // book / text the word came from
  context        String? // the sentence it appeared in
  createdAt      DateTime @default(now())

  entry DictionaryEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  // Owner of this encounter. Nullable so legacy rows survive the migration; they are
  // claimed by the owner account on first login (see src/lib/auth.ts).
  userId String?

  @@index([entryId])
  @@index([userId])
}

/// One practice attempt at filling a blank cell.
model QuizAttempt {
  id         Int      @id @default(autoincrement())
  entryId    Int
  formKey    String
  userAnswer String
  correct    Boolean
  // Genre du raté, quand l'IA en a jugé un ("autre-mot" | "autre-forme" | "oubli") — null sur
  // une réponse correcte ou quand l'IA n'a pas tranché. Voir checkAnswerTolerance().
  mistakeKind String?
  note        String? // courte explication IA (raison du "close" ou du rejet), pour l'historique
  createdAt  DateTime @default(now())

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  userId String? // owner; nullable for legacy rows (claimed on first login)

  @@index([entryId])
  @@index([entryId, formKey])
  @@index([userId])
}

/* ---------- Auth.js tables (standard @auth/prisma-adapter schema) ---------- */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/* ---------- Per-user app state (replaces the former JSON files) ---------- */

/// Highest validated grammatical level per track. Replaces level-progress.json.
model LevelProgress {
  userId String
  track  String // 'declension' | 'conjugation' | 'vocabulary'
  level  Int

  @@id([userId, track])
}

/// A passed TORFL production/comprehension task. Replaces torfl-progress.json.
model TorflProgress {
  userId String
  taskId String

  @@id([userId, taskId])
}

/// Cached Mistral exam recommendation, per user. Replaces reco-cache.json.
model RecoCache {
  userId    String   @id
  signature String
  reco      String // JSON-stringified recommendation
  updatedAt DateTime @default(now())
}

/// Server-side correct answers of a generated QCM. Replaces exam-items.json.
model ExamItem {
  token     String   @id
  userId    String
  correct   String // JSON-stringified number[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/* ---------- Gamification (Duolingo mode) ---------- */

/// Aggregate stats & streak per user.
model UserStats {
  userId           String  @id
  currentStreak    Int     @default(0)
  longestStreak    Int     @default(0)
  lastActivityDate String? // "YYYY-MM-DD" in Europe/Paris
  totalXp          Int     @default(0)
  dailyXpGoal      Int     @default(50)
  streakFreezes    Int     @default(2)
  totalAttempts    Int     @default(0)
  // Date cible pour l'examen ТРКИ-1 (objectif B1), réglable par l'utilisateur — pilote
  // l'estimation de rythme/ETA sur /objectif-b1. Null = pas d'échéance fixée, ETA "au rythme actuel"
  // uniquement.
  b1TargetDate     DateTime?
}

/// XP journal — source of truth for today's XP and history.
model XpEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Int
  source    String // 'quiz' | 'complete' | 'translate' | 'case' | 'speak' | 'sentence' | 'control' | 'torfl' | 'discover' | 'review' | 'bonus'
  day       String // "YYYY-MM-DD" in Europe/Paris
  createdAt DateTime @default(now())

  @@index([userId, day])
}

/// Unlocked achievements (static catalogue in code).
model Achievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  @@id([userId, achievementId])
}

/// SM-2 spaced-repetition state for one inflected form, per user.
model FormReview {
  userId         String
  entryId        Int
  formKey        String
  ease           Float     @default(2.5)
  intervalDays   Float     @default(0)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?

  @@id([userId, entryId, formKey])
  @@index([userId, dueAt])
}

/* ---------- Objectif B1 : examen blanc ТРКИ-1 (M1-M6) ---------- */
/* Voir /home/mderoir/.claude/plans/robust-yawning-plum.md pour le plan complet. Préfixe Trki
   choisi pour ne pas entrer en collision avec ExamItem (feature TORFL-par-tâche, sans rapport). */

/// Sujet ТРКИ-1 généré pour une tentative — un ou plusieurs sous-tests selon ce qui a été demandé
/// à createPaper(). Le blueprint est déterministe et vit en code (src/lib/exam/blueprints/).
model TrkiPaper {
  id               Int       @id @default(autoincrement())
  userId           String
  seed             String // seed RNG, rejouable (src/lib/exam/rng.ts)
  blueprintVersion String // ex. "trki1-lexgram-v1"
  subtests         String // JSON string[] des SubtestCode inclus (1 à 5)
  purpose          String    @default("EXAM") // 'EXAM' (compte pour le banking) | 'PRACTICE'
  status           String    @default("PENDING") // 'PENDING' | 'GENERATING' | 'READY' | 'FAILED'
  error            String?
  createdAt        DateTime  @default(now())
  readyAt          DateTime?

  passages TrkiPassage[]
  items    TrkiItem[]
  attempts TrkiAttempt[]

  @@index([userId])
  @@index([userId, status])
}

/// Texte/script partagé par plusieurs items (lecture : passage écrit ; écoute : script lu par
/// Web Speech API côté client — pas de fichier audio stocké).
model TrkiPassage {
  id      Int       @id @default(autoincrement())
  paperId Int
  paper   TrkiPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subtest String // 'reading' | 'listening'
  typeId  String // ex. "reading.narrative"
  topic   String
  text    String

  items TrkiItem[]

  @@index([paperId])
}

/// Banque d'items validés (§5.4 du spec) : filet en cas d'échec de génération, jamais plus de 20%
/// d'un Paper. Indépendante des Paper individuels — réutilisable dans plusieurs.
model TrkiBankItem {
  id                Int       @id @default(autoincrement())
  subtest           String // 'lexgram' | 'reading' | 'listening' | 'writing' | 'speaking'
  typeId            String
  targetId          String
  payload           String // JSON : forme dépend du subtest, voir src/lib/exam/types.ts
  answerKey         String // JSON : index correct (QCM) ; vide pour writing/speaking (rater)
  distractorClasses String // JSON string[]
  contentHash       String // phrase normalisée, anti-doublon
  validatedBy       String // JSON : trace des passes de validation
  quarantined       Boolean   @default(false) // désaccord passe 6, à trancher sur /admin/quarantine
  // true = rejeté par une passe 1-5 (jamais éligible au tirage/à la banque), conservé uniquement
  // pour le taux de rejet par passe sur /admin/health. false pour un item valide OU quarantiné.
  rejected          Boolean   @default(false)
  usedCount         Int       @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())

  items TrkiItem[]

  @@index([typeId, targetId])
  @@index([contentHash])
  @@index([quarantined])
}

/// Item concret dans UN Paper précis — copie figée, jamais réédité même si le TrkiBankItem
/// d'origine change. bankItemId trace l'origine pour l'anti-répétition (§8 spec) et les stats.
model TrkiItem {
  id         Int           @id @default(autoincrement())
  paperId    Int
  paper      TrkiPaper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  passageId  Int?
  passage    TrkiPassage?  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  bankItemId Int?
  bankItem   TrkiBankItem? @relation(fields: [bankItemId], references: [id], onDelete: SetNull)
  subtest    String
  typeId     String
  targetId   String
  position   Int
  payload    String
  answerKey  String
  points     Int           @default(1)

  responses TrkiResponse[]

  @@index([paperId])
  @@index([passageId])
  @@index([bankItemId])
}

model TrkiAttempt {
  id          Int       @id @default(autoincrement())
  userId      String
  paperId     Int
  paper       TrkiPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  mode        String // 'FULL' | 'PARTIAL' (banking)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  responses TrkiResponse[]
  results   TrkiSubtestResult[]

  @@index([userId])
  @@index([paperId])
}

model TrkiResponse {
  id         Int         @id @default(autoincrement())
  attemptId  Int
  attempt    TrkiAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  itemId     Int
  item       TrkiItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  answer     String // JSON : index (QCM) ou texte/transcript libre (writing/speaking)
  correct    Boolean? // null tant que non corrigé (rater async pour writing/speaking)
  feedback   String? // JSON : grille + errors[] du rater, item par item (writing/speaking)
  answeredAt DateTime    @default(now())

  @@index([attemptId])
  @@index([itemId])
  @@unique([attemptId, itemId])
}

model TrkiSubtestResult {
  attemptId   Int
  attempt     TrkiAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  subtest     String
  rawScore    Float
  maxScore    Float
  ratio       Float
  passed      Boolean
  bankedUntil DateTime? // banking 2 ans
  rubric      String? // JSON, grille agrégée pour writing/speaking

  @@id([attemptId, subtest])
}

/// Cache de la recommandation IA "quoi travailler" — même principe que RecoCache (TORFL) mais
/// dédié pour ne pas entrer en collision avec cet usage existant.
model TrkiFocusCache {
  userId    String   @id
  signature String // hash des KPI au moment du calcul, invalide le cache si les KPI bougent
  reco      String // JSON : { summary, priorities: [...] }
  updatedAt DateTime @default(now())
}

/// Parcours vocabulaire quotidien : quels DictionaryEntry.id composent le "jour N" pour cet
/// utilisateur, et quand ce jour a réellement été entamé (pas forcément un jour calendaire par
/// jour de parcours si l'utilisateur saute des jours).
model B1VocabDay {
  userId       String
  dayIndex     Int
  entryIds     String // JSON int[]
  introducedAt DateTime?

  @@id([userId, dayIndex])
}
